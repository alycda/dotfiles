#!/usr/bin/env python3
# Claude Code adapter for tools/agent/jj-state: read before write.
#
#   UserPromptSubmit         when the repository moved since the agent last
#                            looked (or on the first prompt), add what
#                            changed and where @ is to the prompt
#   PreToolUse  Edit, Write, when the repository moved since the agent last
#   NotebookEdit, and Bash   looked, block once with what changed; the
#   running a jj write       block counts as the look, so a retry runs
#   PostToolUse Bash         a jj command that shows the state (st, log,
#                            op log, evolog, show) or changes it counts as
#                            a look, in the workspace it ran in
#
# State is kept per session and per subagent (agent_id), so one agent's
# look never counts for another.
import json
import os
import subprocess
import sys
from importlib.machinery import SourceFileLoader

sys.dont_write_bytecode = True
root = os.environ.get("CLAUDE_PROJECT_DIR") or os.path.join(
    os.path.dirname(os.path.abspath(__file__)), "..", "..")
tools = os.path.join(root, "tools", "agent")
policy = SourceFileLoader(
    "command_policy", os.path.join(tools, "command-policy")).load_module()

FILE_TOOLS = {"Edit", "MultiEdit", "Write", "NotebookEdit"}


def jj_state(action, key, cwd):
    out = subprocess.run(
        [sys.executable, os.path.join(tools, "jj-state"), action, key,
         "--cwd", cwd], capture_output=True, text=True)
    return out.returncode, out.stdout.strip()


payload = json.load(sys.stdin)
event = payload.get("hook_event_name")
key = payload.get("session_id") or "unknown"
if payload.get("agent_id"):
    key += "/" + payload["agent_id"]
cwd = payload.get("cwd") or os.getcwd()
tool = payload.get("tool_name")
tool_input = payload.get("tool_input") or {}

if event == "UserPromptSubmit":
    _, text = jj_state("look", key, cwd)
    if text:
        json.dump({"hookSpecificOutput": {
            "hookEventName": "UserPromptSubmit",
            "additionalContext": text,
        }}, sys.stdout)

elif event == "PreToolUse":
    if tool in FILE_TOOLS:
        path = tool_input.get("file_path") or tool_input.get("notebook_path")
        places = [os.path.dirname(os.path.join(cwd, path)) if path else cwd]
    elif tool == "Bash":
        # Each workspace a jj write runs in; one the hook cannot place
        # (`cd $DIR && jj new`) is checked as the session's own.
        places = policy.jj_targets(tool_input.get("command", ""), cwd,
                                   ("write",), unknown=cwd)
    else:
        places = []
    blocked = []
    for place in places:
        rc, text = jj_state("check", key, place)
        if rc == 2:
            blocked.append(text)
    if blocked:
        print("\n\n".join(blocked), file=sys.stderr)
        sys.exit(2)

elif event == "PostToolUse" and tool == "Bash":
    # Each workspace a jj look or write ran in; one the hook cannot place is
    # not marked, so it is checked again before the next write.
    for place in policy.jj_targets(tool_input.get("command", ""), cwd,
                                   ("look", "write")):
        jj_state("seen", key, place)

sys.exit(0)
