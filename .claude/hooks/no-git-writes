#!/usr/bin/env python3
# no-git-writes: a Claude Code PreToolUse hook for the Bash tool. In a jj
# repository it blocks git commands that write, and lets git commands that
# only read through. jj owns the repository: a git write behind its back
# (add, commit, checkout, ...) leaves jj to import a state it did not make.
#
# Reads the hook payload on stdin. Exit 0 lets the command run; exit 2
# blocks it, and Claude Code shows stderr to the agent.
#
# A guardrail, not a sandbox: it reads the command line, so git run from a
# script, `bash -c "..."`, `eval` or `$(...)` is not seen.
import json
import os
import re
import shlex
import sys

# Subcommands that never write.
READ = {
    "blame", "cat-file", "check-attr", "check-ignore", "describe", "diff",
    "for-each-ref", "grep", "help", "log", "ls-files", "ls-remote", "ls-tree",
    "merge-base", "name-rev", "rev-list", "rev-parse", "shortlog", "show",
    "show-ref", "status", "var", "version", "whatchanged",
}
# Subcommands that only read when their first argument is one of these.
READ_WHEN = {
    "branch": {None, "-l", "--list", "-a", "-r", "-v", "-vv", "--show-current"},
    "config": {"--get", "--get-all", "--get-regexp", "-l", "--list"},
    "remote": {None, "-v", "get-url", "show"},
    "stash": {"list", "show"},
    "tag": {None, "-l", "--list"},
    "worktree": {"list"},
}
# Global options that take the next word as their value.
GLOBAL_WITH_VALUE = {"-C", "-c", "--git-dir", "--work-tree", "--namespace"}
# Words that run the rest of the line as a command.
WRAPPERS = {"command", "exec", "env", "nice", "time", "sudo", "xargs"}

JJ_ONLY = """\
blocked: `git {sub}` writes, and this is a jj repository.
Use jj: `jj describe`/`jj commit` (commit), `jj new`/`jj edit` (checkout),
`jj restore` (reset/restore), `jj rebase`, `jj git fetch`, `jj git push`.
Reading with git is fine (status, log, diff, show, ...)."""


def in_jj_repo(cwd):
    path = os.path.abspath(cwd)
    while True:
        if os.path.isdir(os.path.join(path, ".jj")):
            return True
        parent = os.path.dirname(path)
        if parent == path:
            return False
        path = parent


def segments(command):
    """Split a command line into simple commands, as lists of words."""
    lexer = shlex.shlex(command, posix=True, punctuation_chars=";&|()\n")
    lexer.whitespace = " \t\r"  # newline separates commands, like ;
    lexer.whitespace_split = True
    words = []
    for token in lexer:
        if token and set(token) <= set(";&|()\n"):
            if words:
                yield words
            words = []
        else:
            words.append(token)
    if words:
        yield words


def git_subcommand(words):
    """The git subcommand and its first argument, or None if not git."""
    i = 0
    # Skip VAR=value assignments and wrappers (also `mise exec --`).
    while i < len(words):
        w = words[i]
        if re.match(r"^[A-Za-z_][A-Za-z0-9_]*=", w) or w in WRAPPERS:
            i += 1
        elif w == "mise" and words[i + 1:i + 2] in (["exec"], ["x"]):
            i += 2
            while i < len(words) and words[i] != "--":
                i += 1
            i += 1
        else:
            break
    if i >= len(words) or os.path.basename(words[i]) != "git":
        return None
    i += 1
    while i < len(words) and words[i].startswith("-"):
        i += 2 if words[i] in GLOBAL_WITH_VALUE else 1
    if i >= len(words):
        return ("", None)  # bare `git`: prints usage
    first = words[i + 1] if i + 1 < len(words) else None
    return (words[i], first)


def writes(sub, first):
    if sub in ("",) or sub in READ:
        return False
    if sub in READ_WHEN:
        return first not in READ_WHEN[sub]
    return True


def main():
    payload = json.load(sys.stdin)
    if payload.get("tool_name") != "Bash":
        return 0
    if not in_jj_repo(payload.get("cwd") or os.getcwd()):
        return 0
    command = payload.get("tool_input", {}).get("command", "")
    try:
        parsed = list(segments(command))
    except ValueError:
        return 0  # unbalanced quotes: let the shell report it
    for words in parsed:
        found = git_subcommand(words)
        if found and writes(*found):
            print(JJ_ONLY.format(sub=found[0]), file=sys.stderr)
            return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
