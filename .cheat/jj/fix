# There are no pre-commit hooks: format a change before moving on from it.
# Formatters (taplo, rumdl, biome) and their scope: tools/jujutsu/config.
# They come from mise, so run these where mise is active, or prefix
# `mise exec --`.

# Format the working-copy change, and any changes on top of it
jj fix

# The habit: format, then start the next change (same arguments as jj new)
jj n
jj n -m "next thing"

# Format another change, and its descendants
jj fix -s <change>

# Also format files the change didn't touch (the whole tree at that change)
jj fix --include-unchanged-files

# Nothing is formatted below the starting change: revsets.fix is @ here.
# Never widen -s to old history; that reformats commits written before
# these formatters existed.

# No dry run: fix, look, and take it back if you don't want it
jj fix && jj diff
jj undo
