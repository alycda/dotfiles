{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opus[1m]",
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": true,
    "compound-engineering@compound-engineering-plugin": true,
    "coding-tutor@compound-engineering-plugin": true,
    "understand-anything@understand-anything": true,
    "typescript-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "datadog@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "compound-engineering-plugin": {
      "source": {
        "source": "github",
        "repo": "EveryInc/compound-engineering-plugin"
      }
    },
    "understand-anything": {
      "source": {
        "source": "github",
        "repo": "Lum1104/Understand-Anything"
      }
    }
  },
  "permissions": {
    "allow": [
      "Bash(gh api *)",
      "Bash(gh label list:*)",
      "Bash(gh pr *)",
      "Bash(gh run *)",
      "Bash(git branch:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git status:*)",
      "Bash(git worktree:*)",
      "Bash(hermes kanban:*)",
      "Bash(just copy:*)",
      "Bash(just fetch:*)",
      "Bash(just info:*)",
      "Bash(just new:*)",
      "Bash(just status:*)",
      "Bash(tb-ticket:*)",
      "Bash(tb:*)",
      "mcp__claude_ai_Linear__get_issue",
      "mcp__claude_ai_Linear__list_comments",
      "mcp__claude_ai_Linear__list_issues",
      "mcp__hackmd__create_note",
      "mcp__linear-server__get_issue",
      "mcp__linear-server__list_comments",
      "mcp__linear-server__list_issues"
    ],
    "ask": [
      "Bash(gh pr comment:*)",
      "Bash(gh pr review:*)",
      "Bash(gh issue comment:*)",
      "mcp__linear-server__save_issue",
      "mcp__claude_ai_Linear__save_comment",
      "mcp__claude_ai_Linear_2__save_comment",
      "mcp__claude_ai_Linear__save_status_update",
      "mcp__claude_ai_Linear_2__save_status_update"
    ],
    "deny": []
  },
  "skipAutoPermissionPrompt": true
}
