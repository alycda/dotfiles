{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  // "cleanupPeriodDays": 90,
  "permissions": {
    "allow": [
        "Bash(cargo check:*)",
        "Bash(gh api:*)",
        "Bash(gh browse:*)",
        "Bash(jj show:*)",
        "Bash(jj st)",
        "Bash(jj bookmark list)"
    ],
    "ask": [
        "Bash(git *)" // prefer jujutsu  
    ],
    "deny": [
        "Bash(exit)" // claude may unintentionally exit itself when trying to exit a shell?
    ]
  }
}
