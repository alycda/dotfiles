# crush ships via nix (lib/core-packages.nix), from charmbracelet/nur rather
# than nixpkgs - see lib/charm-nur.nix. Unfree license (FSL-1.1-MIT), so
# cache.nixos.org has nothing for it either way, but charm-nur serves Charm's
# own release binaries, so first eval downloads rather than compiles.

# Venice is a built-in crush provider (catwalk's venice.json): base URL and
# the whole model catalog ship with crush; it only needs $VENICE_API_KEY.
# The key lives in the keychain under envchain's "venice" namespace, and
# tools/crush/crushrc (linked by crush.nix) feeds it in at startup.
# Where envchain is absent (devcontainer), export it instead:
export VENICE_API_KEY=<your-key>

# To check the keychain entry without printing it:
envchain venice printenv VENICE_API_KEY | wc -c

# To run on a specific Venice model (IDs as crush models lists them):
crush run -m venice/kimi-k3 "prompt"
crush run -m venice/openai-gpt-6-astra "prompt"

# To list the models crush can see across configured providers:
crush models

# To run one-shot / interactive / auto-accept:
crush run "prompt"
crush
crush --yolo

# To show config and data directories:
crush dirs
