# crush ships via nix (lib/core-packages.nix), from charmbracelet/nur rather
# than nixpkgs - see lib/charm-nur.nix. Unfree license (FSL-1.1-MIT), so
# cache.nixos.org has nothing for it either way, but charm-nur serves Charm's
# own release binaries, so first eval downloads rather than compiles.

# To wire Venice as an OpenAI-compatible provider, in ~/.config/crush/crushrc
# (config file directives, NOT CLI subcommands - crush 0.91 still has no
# `crush provider` command; `update-providers` refreshes the catalog from a
# path or URL, it does not add one):
#   provider add venice --type openai-compat \
#     --base-url "https://api.venice.ai/api/v1" \
#     --api-key "$VENICE_API_KEY"
#   model add venice/<model-id> \
#     --name "<display name>" \
#     --context-window <tokens> \
#     --default-max-tokens <tokens>

# Until it's wired into home-manager sessionVariables, export it manually:
export VENICE_API_KEY=<your-key>

# To list the models crush can see across configured providers:
crush models

# To run one-shot / interactive / auto-accept:
crush run "prompt"
crush
crush --yolo

# To show config and data directories:
crush dirs
