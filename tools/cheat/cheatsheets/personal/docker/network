# Run a container on its own named network instead of the default bridge.
# Containers on a named network can reach each other by container name, and
# you choose which containers join. It is NOT a sandbox: the container can
# still reach the internet. (docker/dev.sh uses --network host, the opposite.)
docker network create claude-net

docker run -it --rm \
  --network claude-net \
  -v "$PWD":/workspace:rw \
  <image>

# Runnable: just -g docker-net [name]

# To actually cut a container off from the internet, the network must be
# INTERNAL - docker then adds no gateway and installs no NAT for it, so nothing
# on it has a default route. A bridge network (above) does not do this.
docker network create --internal locked-net
docker run --rm --network locked-net alpine \
  sh -c 'awk "\$2==\"00000000\"" /proc/net/route'   # empty = no way out

# Anything the container still needs (a model endpoint, an allowlisted host)
# gets a door: a second container on BOTH networks, forwarding one destination.
# Worked example, with a verify command: docker/hermes-box/ (cheat hermes/box)
