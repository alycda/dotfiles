# Hermes in a box: local model, no route to the internet.
# Full write-up + threat model: docker/hermes-box/README.md

# First run (host's ollama keeps the GPU; the agent still can't address the host)
box=~/dotfiles/docker/hermes-box
$box/hermes-box.sh init         # ~/.hermes-box + seeded config.yaml
$EDITOR ~/.hermes-box/config.yaml   # model.default must be a model you have
cd ~/code/some-project          # cwd = the agent's /workspace
$box/hermes-box.sh up           # refuses (rw) if cwd contains the box itself
$box/hermes-box.sh verify       # DO THIS. It has a control and can say "inconclusive".
$box/hermes-box.sh chat

# Fully self-contained instead (CPU-only: no GPU passthrough on macOS docker)
export HERMES_BOX_MODE=contained-model
$box/hermes-box.sh pull qwen2.5-coder:14b   # opens the fetch door, pulls, closes it
$box/hermes-box.sh up

# The one claim, checkable without the script:
docker network inspect hermes-box -f '{{.Internal}}'        # true
docker exec hermes-box awk '$2=="00000000"' /proc/net/route # empty = no default route

# Let exactly one host through (anchored! a bare pattern is a substring match):
#   echo '^docs\.ditto\.live$' >> $box/net/allowlist
$box/hermes-box.sh up --allowlist
$box/hermes-box.sh proxy-log       # every allow and deny, by hostname

# Read-only workspace when the agent should look and not touch:
HERMES_BOX_WORKSPACE_MODE=ro $box/hermes-box.sh up

# NOT the same thing: `just -g docker-net` makes a bridge network, which has a
# gateway and NAT. It segments containers from each other, not from the internet.

# Runnable: just hermes-box <command>  (workspace = where you ran just)
