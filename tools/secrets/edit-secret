#!/usr/bin/env bash
# edit-secret NAME: create or edit secrets/NAME.age, an agenix secret, in
# $EDITOR. NAME is its path under secrets/, without .age (personal/api-key).
#
#   edit-secret personal/api-key       # or: just edit-secret personal/api-key
#
# ragenix edits only files secrets/secrets.nix lists, and it lists the files
# that exist, so a new secret is first created, encrypted to
# secrets/recipients.txt. Not empty: ragenix fails on an empty secret with
# "No such file or directory", so it starts as a line to replace. Needs rage and ragenix, from the flake's dev shell
# (`nix develop`, or direnv). AGE_IDENTITY overrides the identity.
set -euo pipefail

name="${1:?usage: edit-secret NAME (its path under secrets/, without .age)}"
name="${name%.age}"
identity="${AGE_IDENTITY:-$HOME/.age/personal-key.txt}"
cd "$(dirname "$(readlink -f "$0")")/../.."

for tool in rage ragenix; do
  command -v "$tool" >/dev/null || {
    echo "edit-secret: $tool not found; run it in the flake's dev shell (nix develop)" >&2
    exit 1
  }
done
[ -r "$identity" ] || {
  echo "edit-secret: no age identity at $identity" >&2
  exit 1
}
# Without a trailing newline in the identity, ragenix fails on every secret
# with "Tried to reset after the underlying buffer was exceeded", which reads
# as corruption.
if [ -n "$(tail -c 1 "$identity")" ]; then
  echo "edit-secret: $identity has no trailing newline; ragenix can't read it." >&2
  echo "  fix: echo >> $identity" >&2
  exit 1
fi

file="secrets/$name.age"
if [ ! -e "$file" ]; then
  mkdir -p "$(dirname "$file")"
  echo "replace this line with the secret" | rage -a -R secrets/recipients.txt -o "$file"
  echo "edit-secret: created $file"
fi
exec ragenix --rules secrets/secrets.nix -i "$identity" -e "$file"
