<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.alyssa.ledger-duedates</string>
  <!-- duedates.sh notifies itself and exits silently when nothing is wrong.
       It must NOT be wrapped in notify.sh "$(...)" — that sent an empty
       Signal message every single day regardless of content. -->
  <key>ProgramArguments</key>
  <array>
    <string>/Users/alyssa/ledger-ingest/duedates.sh</string>
    <string>14</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>30</integer></dict>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>/Users/alyssa/ledger-ingest/duedates.out.log</string>
  <key>StandardErrorPath</key><string>/Users/alyssa/ledger-ingest/duedates.out.log</string>
</dict>
</plist>
