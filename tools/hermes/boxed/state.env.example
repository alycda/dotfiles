# ~/hermes-boxed/state/.env — secrets provisioned per-machine, never tracked.
# Derived from the host ~/.hermes/.env at capture time; key names only here.

# Venice (OpenAI-compatible) — primary inference provider
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.venice.ai/api/v1

# Gateway HTTP API (workspace UI auth) — must match workspace.env HERMES_API_TOKEN
API_SERVER_ENABLED=true
API_SERVER_HOST=0.0.0.0
API_SERVER_KEY=

# Signal channel (signal-cli daemon on the shared compose network)
SIGNAL_HTTP_URL=http://signal-cli:8080
SIGNAL_ACCOUNT=
SIGNAL_ALLOWED_USERS=
SIGNAL_HOME_CHANNEL=

# Ledger MCP broker (host-side privilege boundary) — token from ~/ledger-broker/token
MCP_LEDGER_API_KEY=

# here.now publishing (optional; skill works anonymously without it)
HERENOW_API_KEY=
