# jj settings for every repo, shared by both kinds of account. home-manager
# links this file to ~/.config/jj/conf.d/dotfiles.toml; tools/mise/bootstrap.sh
# links the same path for the account without Nix. conf.d is merged over
# config.toml, so never put a [user] block here: it would beat
# `jj config set --user` (and the mise identity task).

# The commit message format (the commit-craft skill) for every repo. A new
# description opens with the format as JJ: lines, which jj drops on save.
[template-aliases]
default_commit_description = '''
"\n\n" ++
"JJ: Subject: <area>(<scope>): <summary>. Lowercase summary, no period,\n" ++
"JJ: 72 characters at most. Then a blank line, then the body, wrapped at 72.\n" ++
"JJ: Body, in this order:\n" ++
"JJ:   1. Why: the problem or need, with the evidence.\n" ++
"JJ:   2. What and how: what changes, and why this way.\n" ++
"JJ:   3. Verification: what you ran and saw, and what you did not run.\n" ++
"JJ:   4. What is left: follow-up work and known limits.\n"
'''

# `jj push`: check the messages of the stack that is not on trunk yet, then
# `jj git push` with the same arguments. jj runs no git hooks, so this is
# where the format is enforced. check-commits is on PATH through home-manager,
# or mise's [env] on the account without Nix. `jj git push` still works when
# a repo has its own format.
[aliases]
push = [
  "util",
  "exec",
  "--",
  "sh",
  "-c",
  "check-commits --jj && exec jj git push \"$@\"",
  "jj-push",
]
