{
    // disable copilot
    "chat.agent.enabled": false,
    "chat.disableAIFeatures": true,
    "editor.rulers": [80],
    "editor.wordWrap": "on",
    "files.associations": {
        "**/.cheat/**": "shellscript"
    },
    "files.exclude": {
        "**/.jj": true // at this level (above jj workspaces), don't ignore .jj folders
    },
    // put the following two lines in .vscode/settings.local.json if VisualJJ/JJK
    //   are installed outside of the devcontainers
    // "git.confirmSync": false,
    // "git.enabled": false, // disable git for jj
    "search.exclude": {
        "**/.jj": true
    },
    // hide copilot
    "workbench.secondarySideBar.defaultVisibility": "hidden"
}
