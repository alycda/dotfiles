// Mise: the account with no Nix and no admin rights.
{
    "name": "dotfiles (mise, no Nix)",
    // Stock image, no Nix anywhere in it on purpose: the point of this is
    // that mise alone is enough.
    "image": "mcr.microsoft.com/devcontainers/base:bookworm",

    // Install mise before VS Code attaches. onCreateCommand finishes before
    // extensions start; postCreateCommand runs after, which is why
    // mise-vscode found no binary. The zsh installer also adds the activate
    // line to ~/.zshrc, as on the Mac, so mise's tools are on zsh's PATH.
    "onCreateCommand": "curl -fsSL https://mise.run/zsh | sh",

    // The test. Trust this checkout's mise.toml, apply its [dotfiles], and print
    // the status: both entries should stop reading "missing". No --force, so
    // a genuine conflict is reported rather than overwritten. Then the
    // claude-hooks task, so a Claude session in here leaves its resume pointer
    // on the taskbook board like one on the host.
    "postCreateCommand": "~/.local/bin/mise trust && ~/.local/bin/mise dotfiles apply -y && ~/.local/bin/mise install && ~/.local/bin/mise dotfiles status && ~/.local/bin/mise run claude-hooks",

    // The host's taskbook data, so tb in here and tb outside show one board.
    // tb takes storage.lock around writes, so two sessions ending together
    // is fine. A bind mount, not a volume: a volume would be a second board
    // that nothing outside the container reads.
    "mounts": [
        "source=${localEnv:HOME}/.taskbook,target=/home/vscode/.taskbook,type=bind"
    ],

    "remoteEnv": {
        "GIT_ORIGIN_REMOTE": "git@github.com:alycda/dotfiles.git",
        "JJ_USER": "${localEnv:JJ_USER}",
        "JJ_EMAIL": "${localEnv:JJ_EMAIL}"
    },

    "customizations": {
        "vscode": {
            "extensions": [
                "editorconfig.editorconfig",
                "hverlin.mise-vscode",
                "jjk.jjk",
                "skellock.just",
                "tamasfe.even-better-toml",
                // replaces git as Source Control
                "visualjj.visualjj"
            ],
            "settings": {
                // zsh, so a new terminal is the test: [dotfiles] added the line
                // to ~/.zshrc that sources interactive.zsh, which sets AUTO_CD.
                // Typing `..` works only if that whole chain did.
                "terminal.integrated.defaultProfile.linux": "zsh",

                // disable copilot
                "chat.disableAIFeatures": true,
                "editor.rulers": [80],
                "editor.wordWrap": "on",
                "files.exclude": {
                    "**/.jj": true
                },
                "git.confirmSync": false,
                // disable git for jj
                "git.enabled": false,
                "search.exclude": {
                    "**/.jj": true
                },
                "sourceControl.providers": [
                    "jujutsu" // keep only the Jujutsu provider
                ],
                // hide copilot
                "workbench.secondarySideBar.defaultVisibility": "hidden"
            }
        }
    },

    // https://code.visualstudio.com/docs/sourcecontrol/faq#_why-is-vs-code-warning-me-that-the-git-repository-is-potentially-unsafe
    "postStartCommand": "git config --global --add safe.directory ${containerWorkspaceFolder}",

    // Install the HUID Tasks extension from this checkout on every attach, so
    // the container always runs the checked-out version. postAttach, not
    // postCreate: the script installs through the VS Code server's CLI, which
    // only exists once VS Code has attached. Called by path: it needs only
    // bash and zip, not just or mise.
    "postAttachCommand": "tasks/scripts/huid-tasks-vscode"
}
