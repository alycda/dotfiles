#!/usr/bin/env bash
# check-links: fail on a tracked symlink that points nowhere, such as
# AGENTS.md (to CLAUDE.md) or a skill in .agents/skills/ (to .claude/skills/)
# after its target moves.
#
# Lists the checkout's files the way shell-files does: jj's from a jj
# workspace, else git's.
set -euo pipefail

if root="$(jj root 2>/dev/null)"; then
  cd "$root"
  list() { jj file list | tr '\n' '\0'; }
else
  cd "$(git rev-parse --show-toplevel)"
  list() { git ls-files -z --cached --others --exclude-standard; }
fi

status=0
while IFS= read -r -d '' f; do
  if [ -L "$f" ] && [ ! -e "$f" ]; then
    echo "broken link: $f -> $(readlink "$f")" >&2
    status=1
  fi
done < <(list)
exit "$status"
