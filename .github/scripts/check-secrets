#!/usr/bin/env bash
# check-secrets: every .age file under secrets/ is an age file with one X25519
# stanza for each key in secrets/recipients.txt, the keys secrets.nix encrypts
# every secret to.
#
# Without a key this is as far as a check can go. An age header doesn't name
# its recipients (an X25519 stanza holds an ephemeral share, not the public
# key), so a secret encrypted to the wrong key of the right count passes, and
# whether a secret decrypts can't be checked at all. What it does catch: a
# plaintext file named .age, and a key added to recipients.txt without
# re-encrypting (`ragenix --rules secrets/secrets.nix -r`), which leaves the
# new key's machine warning that it can't decrypt.
set -euo pipefail
cd "$(dirname "$0")/../.."

begin='-----BEGIN AGE ENCRYPTED FILE-----'
want=$(grep -c '^age1' secrets/recipients.txt || true)
[ "$want" -gt 0 ] || {
  echo "secrets/recipients.txt lists no age1 keys" >&2
  exit 1
}

tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT

# header FILE: the age header, up to and excluding its "--- " MAC line, from
# the armored form (base64 between the BEGIN and END lines) or the binary.
# Decoded to a file first, since awk stops reading at the MAC line.
header() {
  if [ "$(head -n 1 "$1" | tr -d '\r')" = "$begin" ]; then
    sed '1d;/^-----END AGE ENCRYPTED FILE-----/,$d' "$1" | base64 -d > "$tmp"
  else
    cp "$1" "$tmp"
  fi
  LC_ALL=C awk '/^--- /{ found = 1; exit } { print } END { exit !found }' "$tmp"
}

status=0
while IFS= read -r -d '' f; do
  if ! h=$(header "$f" 2>/dev/null) || [ "$(head -n 1 <<<"$h")" != age-encryption.org/v1 ]; then
    echo "$f: not an age file" >&2
    status=1
    continue
  fi
  got=$(grep -c '^-> X25519 ' <<<"$h" || true)
  if [ "$got" -ne "$want" ]; then
    echo "$f: encrypted to $got X25519 keys, recipients.txt lists $want;" \
      "re-encrypt: ragenix --rules secrets/secrets.nix -r" >&2
    status=1
  fi
done < <(find secrets -name '*.age' -type f -print0)
exit "$status"
