{
    "name": "dotfiles (Nix-jj)",
    // minimal image for speed
    "image": "mcr.microsoft.com/devcontainers/base:bookworm",

    "features": {
        // enable nix
        "ghcr.io/devcontainers/features/nix:1": {
            // equivalent to `nix profile add` for critical
            "packages": ["jujutsu", "just"]
        }
    },

    "remoteEnv": {
        "GIT_ORIGIN_REMOTE": "git@github.com:alycda/dotfiles.git",
        "JJ_USER": "${localEnv:JJ_USER}",
        "JJ_EMAIL": "${localEnv:JJ_EMAIL}"
    },

    "customizations": {
        "vscode": {
            "extensions": [
                "anthropic.claude-code",
                "davidanson.vscode-markdownlint",
                "editorconfig.editorconfig",
                "jjk.jjk",
                "jnoortheen.nix-ide",
                "skellock.just",
                "tamasfe.even-better-toml",
                // replaces git as Source Control
                "visualjj.visualjj"
            ],
            "settings": {
                // disable copilot
                "chat.agent.enabled": false,
                "chat.disableAIFeatures": true,
                "editor.rulers": [80],
                "editor.wordWrap": "on",
                "files.exclude": {
                    "**/.jj": true
                },
                "git.confirmSync": false,
                // disable git for jj
                "git.enabled": false,
                "search.exclude": {
                    "**/.jj": true
                },
                // hide copilot
                "workbench.secondarySideBar.defaultVisibility": "hidden"
            }
        }
    }
}
