{
    "name": "dotfiles (Nix-jj)",
    // minimal image for speed
    "image": "mcr.microsoft.com/devcontainers/base:bookworm",

    "features": {
        // enable nix
        "ghcr.io/devcontainers/features/nix:1": {
            // equivalent to `nix profile add` for critical. Nothing yet:
            // home-manager installs the tools, direnv included.
            "packages": [],
            "extraNixConfig": "experimental-features = nix-command flakes"
        }
    },

    // Mark the checkout safe first: git, and Nix's git fetcher, refuse a
    // repository owned by another user. Then apply this flake's home-manager
    // configuration for the container's architecture (-b moves the image's
    // ~/.zshrc aside), allow this checkout's .envrc, and build the dev shell
    // once so the first terminal doesn't wait. home-manager hooks direnv into
    // zsh and sets up nix-direnv.
    "postCreateCommand": "git config --global --add safe.directory ${containerWorkspaceFolder} && nix run .#home-manager -- switch -b backup --flake .#vscode@$(uname -m)-linux && ~/.nix-profile/bin/direnv allow && ~/.nix-profile/bin/direnv exec . true",

    // The host's age identity, read-only, so that switch can decrypt the
    // agenix secrets (home-manager/agenix.nix). Without a key it warns and
    // the container works as before. A bind mount whose source is missing
    // stops the container from starting, so initializeCommand, which runs on
    // the host first, makes sure ~/.age exists.
    "initializeCommand": "mkdir -p \"$HOME/.age\"",
    "mounts": [
        "source=${localEnv:HOME}/.age,target=/home/vscode/.age,type=bind,readonly"
    ],

    "remoteEnv": {
        "GIT_ORIGIN_REMOTE": "git@github.com:alycda/dotfiles.git",
        "JJ_USER": "${localEnv:JJ_USER}",
        "JJ_EMAIL": "${localEnv:JJ_EMAIL}"
    },

    "customizations": {
        "vscode": {
            "extensions": [
                "anthropic.claude-code",
                "davidanson.vscode-markdownlint",
                "editorconfig.editorconfig",
                "jjk.jjk",
                "jnoortheen.nix-ide",
                // loads .envrc, so extensions see the dev shell's tools too
                "mkhl.direnv",
                "skellock.just",
                "tamasfe.even-better-toml",
                // replaces git as Source Control
                "visualjj.visualjj"
            ],
            "settings": {
                // zsh: home-manager configures it, and hooks direnv into it.
                "terminal.integrated.defaultProfile.linux": "zsh",

                // disable copilot
                "chat.agent.enabled": false,
                "chat.disableAIFeatures": true,
                "editor.rulers": [80],
                "editor.wordWrap": "on",
                "files.exclude": {
                    "**/.jj": true
                },
                "git.confirmSync": false,
                // disable git for jj
                "git.enabled": false,
                "search.exclude": {
                    "**/.jj": true
                },
                // hide copilot
                "workbench.secondarySideBar.defaultVisibility": "hidden"
            }
        }
    }
}
