{
    "name": "dotfiles (Nix-jj)",
    // minimal image for speed
    "image": "mcr.microsoft.com/devcontainers/base:bookworm",

    "features": {
        // enable nix
        "ghcr.io/devcontainers/features/nix:1": {
            // equivalent to `nix profile add` for critical. direnv loads the
            // flake's dev shell (.envrc); nix-direnv caches it.
            "packages": ["direnv", "nix-direnv"],
            "extraNixConfig": "experimental-features = nix-command flakes"
        }
    },

    // Hook direnv into bash and zsh, load nix-direnv, allow this checkout's
    // .envrc, and build the dev shell once so the first terminal doesn't wait.
    "postCreateCommand": "echo 'eval \"$(direnv hook bash)\"' >> ~/.bashrc && echo 'eval \"$(direnv hook zsh)\"' >> ~/.zshrc && mkdir -p ~/.config/direnv && echo 'source $HOME/.nix-profile/share/nix-direnv/direnvrc' > ~/.config/direnv/direnvrc && direnv allow && direnv exec . true",

    "remoteEnv": {
        // "GIT_ORIGIN_REMOTE": "git@github.com:alycda/dotfiles.git",
        "JJ_USER": "${localEnv:JJ_USER}",
        "JJ_EMAIL": "${localEnv:JJ_EMAIL}"
    },

    "customizations": {
        "vscode": {
            "extensions": [
                "anthropic.claude-code",
                "davidanson.vscode-markdownlint",
                "editorconfig.editorconfig",
                "jjk.jjk",
                "jnoortheen.nix-ide",
                // loads .envrc, so extensions see the dev shell's tools too
                "mkhl.direnv",
                "skellock.just",
                "tamasfe.even-better-toml",
                // replaces git as Source Control
                "visualjj.visualjj"
            ],
            "settings": {
                // disable copilot
                "chat.agent.enabled": false,
                "chat.disableAIFeatures": true,
                "editor.rulers": [80],
                "editor.wordWrap": "on",
                "files.exclude": {
                    "**/.jj": true
                },
                "git.confirmSync": false,
                // disable git for jj
                "git.enabled": false,
                "search.exclude": {
                    "**/.jj": true
                },
                "sourceControl.providers": [
                    "jujutsu" // keep only the Jujutsu provider
                ],
                // hide copilot
                "workbench.secondarySideBar.defaultVisibility": "hidden"
            }
        }
    }
}
