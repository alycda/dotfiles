{
    "name": "dotfiles (Nix)",

    // minimal image for speed
    "image": "mcr.microsoft.com/devcontainers/base:bookworm",

    "features": {
        // Nix only. The tools and dotfiles come from the home-manager profile
        // (postCreateCommand), the same one any other Nix account switches to.
        "ghcr.io/devcontainers/features/nix:1": {
            "extraNixConfig": "experimental-features = nix-command flakes"
        }
    },

    // Apply this checkout's home-manager profile: tools/ files in place, and
    // every tool mise.toml lists. Lifecycle commands don't set $USER, which the
    // home-manager CLI needs.
    // -b backup: home-manager owns zsh, and the image ships its own ~/.zshrc
    // and ~/.zprofile (oh-my-zsh), which it would otherwise refuse to replace.
    "postCreateCommand": "USER=$(id -un) nix run .#home-manager -- switch -b backup --flake \".#vscode@$(uname -m)-linux\"",

    "remoteEnv": {
        "GIT_ORIGIN_REMOTE": "git@github.com:alycda/dotfiles.git",
        "JJ_USER": "${localEnv:JJ_USER}",
        "JJ_EMAIL": "${localEnv:JJ_EMAIL}"
    },

    // Install the HUID Tasks extension from this checkout on every attach, so
    // the container always runs the checked-out version. postAttach, not
    // postCreate: the script installs through the VS Code server's CLI, which
    // only exists once VS Code has attached. Called by path: it needs only
    // bash and zip, not just or mise.
    "postAttachCommand": "tasks/scripts/huid-tasks-vscode",

    "customizations": {
        "vscode": {
            "extensions": [
                "editorconfig.editorconfig",
                "jjk.jjk",
                "jnoortheen.nix-ide",
                "skellock.just",
                "tamasfe.even-better-toml",
                // replaces git as Source Control
                "visualjj.visualjj"
            ],
            "settings": {
                // disable copilot
                "chat.disableAIFeatures": true,
                "editor.rulers": [80],
                "editor.wordWrap": "on",
                "files.exclude": {
                    "**/.jj": true
                },
                "git.confirmSync": false,
                // disable git for jj
                "git.enabled": false,
                "search.exclude": {
                    "**/.jj": true
                },
                "sourceControl.providers": [
                    "jujutsu" // keep only the Jujutsu provider
                ],
                // hide copilot
                "workbench.secondarySideBar.defaultVisibility": "hidden"
            }
        }
    }
}
